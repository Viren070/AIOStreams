{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "gen:env-docs": "tsx ../../scripts/gen-env-docs.ts && prettier --write ./content/docs/configuration/environment-variables.mdx",
    "prebuild": "pnpm run gen:env-docs",
    "build": "next build",
    "predev": "pnpm run gen:env-docs",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.0",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0",
    "takumi-js": "^2.14.0",
    "zbsearch": "^4.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.29",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "~1.0.7",
    "typescript": "^5.9.3"
  }
}
